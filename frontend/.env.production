# Backend URL used for production builds (Vercel).
#
# Vite inlines VITE_* variables into the bundle at build time, so this has to
# be correct *before* the build runs. Keeping it in the repo rather than only
# in the Vercel dashboard means the deployed frontend cannot silently point at
# the wrong backend because a dashboard value drifted or a variable was typed
# as a Secret (Vercel does not expose those to the client bundle).
#
# This is a public URL, not a credential. Real secrets stay in .env, which is
# git-ignored. A platform environment variable of the same name still wins, so
# the dashboard can override this per-environment when needed.
VITE_API_BASE_URL=https://lyftr-llm-chatbot-rpo2.onrender.com
