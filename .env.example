# Copy to .env and fill in real values. .env is git-ignored; real keys never
# belong in the repository.

# ---------------------------------------------------------------- key pool --
# At least 2 comma-separated API keys. Ids are assigned in this order:
# the first becomes key_1, the second key_2, and so on. Failover walks the
# list top to bottom.
LLM_API_KEYS=your-first-api-key,your-second-api-key

# LiteLLM model used for every key unless LLM_MODELS overrides it.
LLM_MODEL=groq/openai/gpt-oss-120b

# Optional: one model per key, positionally aligned with LLM_API_KEYS. Leave
# blank to use LLM_MODEL for all of them. Example for a mixed pool:
#   LLM_MODELS=groq/openai/gpt-oss-120b,groq/qwen/qwen3.8-27b
LLM_MODELS=

# ----------------------------------------------------------------- storage --
# SQLite only. In Docker this path is on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# -------------------------------------------------------------------- http --
# Comma-separated CORS origins allowed to call the backend. Use the deployed
# frontend origin in production, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------------- behaviour --
# Enables the X-Simulate-Failure test hook. Must be true on the deployed
# backend so failover can be demonstrated.
ENABLE_FAILURE_SIMULATION=true

DEFAULT_SYSTEM_PROMPT=You are a concise, helpful assistant. Answer clearly and accurately.
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.0
REQUEST_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------ cache --
# "disk" persists LiteLLM's cache under CACHE_DIR; "local" keeps it in memory.
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_ENABLED=true

# --------------------------------------------------------------- frontend --
# Base URL of the backend, baked into the bundle at build time.
# Local Docker: http://localhost:8000   Deployed: https://<your-backend>.onrender.com
VITE_API_BASE_URL=http://localhost:8000
